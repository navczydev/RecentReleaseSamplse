<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.RecentReleaseSamplse" parent="android:Theme.Material.Light.NoActionBar" />
    <!-- Base application theme. -->
    <style name="Base.Theme.RecentReleaseSamplse" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your light theme here. -->
        <!-- <item name="colorPrimary">@color/my_light_primary</item> -->
    </style>

    <style name="Widget.LibTheme.NotificationView" parent="">
        <item name="notificationdColor">@color/notificationBackground</item>
        <item name="textColor">@color/notificationText</item>
    </style>

    <attr name="titleSize" format="dimension" />
    <attr name="titleStyle">
        <enum name="normal" value="0" />
        <enum name="bold" value="1" />
        <enum name="italic" value="1" />
    </attr>


    <declare-styleable name="DefaultStylesTheme">
        <attr name="notificationViewStyle" format="reference" />
    </declare-styleable>

    <declare-styleable name="NotificationView">
        <attr name="titleSize" />
        <attr name="titleStyle" />
        <attr name="detailSize" format="dimension" />
        <attr name="detailStyle">
            <enum name="normal" value="0" />
            <enum name="bold" value="1" />
            <enum name="italic" value="2" />
        </attr>
        <attr name="notificationdColor" format="color" />
        <attr name="textColor" format="reference|color" />
    </declare-styleable>

    <style name="FullScreenDialogStyle" parent="Theme.AppCompat.Dialog">
        <item name="android:windowNoTitle">true</item>
        <item name="colorPrimaryDark">@color/design_default_color_primary_dark</item>
        <item name="colorPrimary">@color/design_default_color_primary</item>

        <!-- Set this to true if you want Full Screen without status bar -->
        <item name="android:windowFullscreen">false</item>

        <item name="android:windowIsFloating">false</item>

        <!-- This is important! Don't forget to set window background -->
        <item name="android:windowBackground">@color/notificationBackground</item>
        <item name="android:textColor">@color/notificationText</item>
    </style>

</resources>