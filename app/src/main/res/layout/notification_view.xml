<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tool="http://schemas.android.com/tools"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:id="@+id/notification_view"
    android:background="@color/notificationBackground"
    tools:context="com.example.recentreleasesamplse.NotificationView">

    <ImageView
        android:id="@+id/notification_icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/alert_icon_margin_left"
        android:layout_marginTop="@dimen/alert_icon_margin_top"
        android:layout_marginBottom="@dimen/alert_icon_margin_bottom"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_launcher_foreground"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/notification_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/alert_title_margin_left"
        android:layout_marginTop="@dimen/alert_title_margin_top"
        android:layout_marginEnd="@dimen/alert_title_margin_right"
        android:layout_marginBottom="@dimen/alert_title_margin_top"
        android:textStyle="normal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/notification_details"
        app:layout_constraintStart_toEndOf="@+id/notification_icon"
        app:layout_constraintTop_toTopOf="parent"
        tool:text="This is the title of the alert" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/notification_details"
        style="@style/Widget.MaterialComponents.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/alert_details_margin_top"
        android:layout_marginEnd="@dimen/alert_details_margin_right"
        android:layout_marginBottom="@dimen/alert_details_margin_top"
        android:text="@string/principal_btn_details_label"
        android:textColor="@color/black"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>